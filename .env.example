# App
APP_NAME=Cloud FastAPI Deployment
APP_VERSION=1.0.0
ENVIRONMENT=local
DEBUG=false
ALLOWED_ORIGINS=*

# Local smoke test option:
# DATABASE_URL=sqlite:///./local.db

# RDS PostgreSQL option, replace values with your RDS information:
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_RDS_ENDPOINT:5432/fastapi_prod

# AWS/S3
AWS_REGION=ap-southeast-1
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET_NAME=fastapi-app-files-YOUR_ID
S3_UPLOAD_PREFIX=uploads
PRESIGNED_URL_EXPIRATION_SECONDS=3600

# Local/GitHub Actions only if you use IAM access keys instead of an EC2 IAM role.
# Never commit real credentials.
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
